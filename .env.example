# ==========================================================
# AI Video Intelligence Platform - environment configuration
#
# Copy this file to `.env` and fill in real values for local
# development. `.env` is git-ignored and must never be committed.
# Every value below is a placeholder - none of them are real
# secrets. For Docker Compose, this file is read automatically
# (POSTGRES_*/NEXT_PUBLIC_* interpolation) and also passed into
# the api/celery containers via `env_file`.
#
# Variable names below match app/config/settings.py's Field
# aliases exactly, grouped the same way; a couple of exceptions
# are called out explicitly where they are NOT read through the
# Settings class.
# ==========================================================

##########################################################
# Application (app.config.settings.AppSettings)
##########################################################
APP_NAME=AI Video Intelligence Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

##########################################################
# Server (app.config.settings.ServerSettings)
##########################################################
HOST=0.0.0.0
PORT=8000

##########################################################
# Security (app.config.settings.SecuritySettings)
##########################################################
# Generate a real value for anything beyond local development,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# JSON array of allowed browser origins for CORS - used directly by
# app/middleware/cors.py. Defaults to the local frontend dev server
# origins when unset. In production, set this to your real public
# frontend origin(s), e.g.: CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

##########################################################
# Database (app.config.settings.DatabaseSettings)
##########################################################
# Local (no Docker): postgresql+psycopg://postgres:postgres@localhost:5432/ai_video
# Docker Compose:    postgresql+psycopg://postgres:postgres@db:5432/ai_video
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_video

# Only used by docker-compose.yml to initialize the "db" (Postgres)
# service itself - keep these in sync with the credentials embedded
# in DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_video

# Connection pool tuning - defaults are reasonable for a single API
# instance; raise DB_POOL_SIZE/DB_MAX_OVERFLOW if you run more
# concurrent API workers/requests than the defaults allow.
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

##########################################################
# Redis
##########################################################
# Not currently read through the Settings class - reserved for a
# future direct Redis client (Celery below already has its own
# broker/backend variables).
REDIS_URL=redis://localhost:6379/0

##########################################################
# Celery (app.workers.celery_app)
##########################################################
# Broker/backend URLs are read directly via os.getenv, NOT through
# app.config.settings.Settings.
# Local (no Docker):     redis://localhost:6379/0
# Docker Compose:        redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Everything below IS read through app.config.settings.CelerySettings.
# task_queue: "celery_cpu" or "celery_gpu" - which queue the API
# publishes new process_video tasks to by default, and which queue a
# worker with no explicit `-Q` override consumes from. See that
# class's docstring for the CPU/GPU worker routing model.
CELERY_TASK_QUEUE=celery_cpu
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_MAX=60

# How long (seconds) the Redis broker holds an in-flight task's
# message invisible to other workers before redelivering it. Left
# unset, Redis's own transport default (3600s/1h) applies regardless
# of task_acks_late - meaning a crashed/restarted worker's job would
# sit invisible for up to an hour before recovering. Safe to keep well
# under task_time_limit here specifically because a redelivered task
# for an already-claimed/finished job is a guaranteed no-op (the
# atomic PENDING->RUNNING claim in app/pipelines/processing_pipeline.py
# absorbs it).
CELERY_BROKER_VISIBILITY_TIMEOUT=1800

# docker-compose.yml/docker-compose.prod.yml command-line concurrency
# (not read through Settings) - recommend 1 for a GPU worker so
# worker-side Prometheus metrics stay accurate (see
# backend/app/workers/metrics.py's multiprocess-metrics caveat) and to
# avoid multiple heavy AI tasks contending for the same GPU.
CELERY_WORKER_CONCURRENCY=2
CELERY_GPU_WORKER_CONCURRENCY=1

##########################################################
# HuggingFace (app.config.settings.HuggingFaceSettings)
##########################################################
# Only required if a model actually needs authenticated download.
HF_TOKEN=

##########################################################
# LLM (app.config.settings.LLMSettings)
##########################################################
# Local (no Docker):     http://localhost:11434
# Docker Compose:        set to wherever your Ollama instance is
# reachable from inside the containers (e.g. http://host.docker.internal:11434) -
# Ollama itself is not part of this project's Compose stack.
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM=qwen3:8b

##########################################################
# Speech (app.config.settings.SpeechSettings)
##########################################################
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
SPEECH_VAD_ENABLED=True
SPEECH_VAD_THRESHOLD=0.5
SPEECH_VAD_MIN_SILENCE_DURATION_MS=2000
LANGUAGE_DETECTION_FALLBACK_THRESHOLD=0.5
SPEECH_DIARIZATION_ENABLED=False
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

##########################################################
# Chapter & Topic Intelligence (app.config.settings.ChapterSettings)
##########################################################
CHAPTER_USE_EMBEDDING_SEGMENTATION=True
CHAPTER_TOPIC_SIMILARITY_THRESHOLD=0.6
CHAPTER_MIN_TOPIC_SEGMENTS=3
CHAPTER_SIMILARITY_THRESHOLD=0.5
CHAPTER_MAX_TOPICS_PER_CHAPTER=4
CHAPTER_MIN_DURATION_SECONDS=15.0
CHAPTER_USE_LLM_LABELING=True

##########################################################
# Quiz Generation (app.config.settings.QuizSettings)
##########################################################
QUIZ_LLM_ENABLED=True
QUIZ_MCQ_COUNT=3
QUIZ_TRUE_FALSE_COUNT=2
QUIZ_SHORT_ANSWER_COUNT=2
QUIZ_MAX_CONTEXT_CHARS=6000

##########################################################
# Flashcard Generation (app.config.settings.FlashcardSettings)
##########################################################
FLASHCARD_LLM_ENABLED=True
FLASHCARD_COUNT=8
FLASHCARD_MAX_CONTEXT_CHARS=6000

##########################################################
# Knowledge Graph Extraction (app.config.settings.KnowledgeGraphSettings)
##########################################################
KG_LLM_ENABLED=True
KG_MAX_ENTITIES_PER_CHUNK=15
KG_MAX_RELATIONS_PER_CHUNK=20
KG_MAX_CONTEXT_CHARS=4000
KG_MIN_CONFIDENCE=0.0

##########################################################
# Retrieval & Reranking (app.config.settings.RetrievalSettings)
##########################################################
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RRF_K=60
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_RERANKING_ENABLED=true

##########################################################
# AI Quality Evaluation (app.config.settings.EvaluationSettings)
##########################################################
EVALUATION_ENABLED=True
EVALUATION_DEFAULT_TOP_K=5
EVALUATION_BERTSCORE_MODEL=
EVALUATION_BERTSCORE_LANG=en
EVALUATION_LLM_JUDGE_ENABLED=False
EVALUATION_LATENCY_ITERATIONS=10

##########################################################
# Logging (app.config.settings.LogSettings)
##########################################################
LOG_LEVEL=INFO
# JSON lines instead of human-readable text - useful when logs are
# collected by an aggregator (CloudWatch, Loki, etc.).
LOG_JSON=False

##########################################################
# Metrics (app.config.settings.MetricsSettings)
##########################################################
METRICS_ENABLED=True
# Port the Celery worker's own Prometheus exporter listens on (the
# API exposes GET /metrics directly instead - see app/core/metrics.py).
METRICS_WORKER_PORT=9100

##########################################################
# Storage (app.config.settings.StorageSettings)
##########################################################
# "local" (default) uses the existing storage/ filesystem layout
# unchanged. "s3" targets any S3-compatible endpoint (AWS S3 or
# MinIO) via boto3 - credentials come from the standard
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars or an IAM role,
# not from a setting here.
STORAGE_BACKEND=local
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=

# Upload validation - applied to POST /videos/upload before a file is
# ever written to disk.
STORAGE_MAX_UPLOAD_SIZE_MB=5000
STORAGE_ALLOWED_UPLOAD_EXTENSIONS=[".mp4",".mov",".mkv",".avi",".webm",".m4v"]

##########################################################
# Rate Limiting (app.config.settings.RateLimitSettings)
##########################################################
# Redis-backed (fixed-window, per client IP), reuses the same Redis
# instance Celery already requires. Fails open (never blocks a
# request) if Redis is unreachable, so a Redis outage cannot also take
# down login/upload. Defaults are generous enough for normal local
# development; tighten for a real production deployment if needed.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_EXPORT_PER_MINUTE=20

##########################################################
# Production Compose resource limits (deployment/docker/
# docker-compose.prod.yml only - not read through Settings)
##########################################################
# Conservative starting points, not universally-correct values - tune
# for your actual hardware/workload (see docs/deployment.md).
API_CPU_LIMIT=2
API_MEMORY_LIMIT=2g
WORKER_CPU_LIMIT=2
WORKER_MEMORY_LIMIT=4g
DB_CPU_LIMIT=2
DB_MEMORY_LIMIT=2g
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=512m

##########################################################
# Local monitoring profile (docker-compose.yml "monitoring" profile
# only - not read through Settings)
##########################################################
GRAFANA_ADMIN_PASSWORD=admin

##########################################################
# Frontend (frontend/ - build-time only, never a secret)
##########################################################
# Consumed at Next.js build time and baked into the client bundle -
# never put anything secret here. Local (no Docker): the backend's
# published port; Docker Compose frontend profile: same, since the
# browser (not the frontend container) calls this URL directly.
NEXT_PUBLIC_API_URL=http://localhost:8001
