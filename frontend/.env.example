# Backend API origin, browser-facing (see frontend/src/lib/constants.ts).
# Must be reachable from the browser running on the host, not a
# Docker-internal service name like "api" (that only resolves inside
# the Docker network) - the published host port for the api service
# (see docker-compose.yml) is 8001.
NEXT_PUBLIC_API_URL=http://localhost:8001
